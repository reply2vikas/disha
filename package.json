{
  "name": "disha",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Context-aware legal document navigator — grounded, evidence-verified legal reading assistant (informational only).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint src tests server scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "validate:live": "tsx scripts/run-live-validation.ts",
    "generate:fixtures": "node scripts/generate-fixtures.mjs",
    "evaluate:repository": "node scripts/evaluate-repository.mjs",
    "generate:sample": "node scripts/make-sample.mjs"
  },
  "dependencies": {
    "@google/genai": "^0.14.0",
    "express": "^4.21.2",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.3",
    "jsdom": "^25.0.1",
    "oxlint": "^0.9.10",
    "typescript": "~5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
